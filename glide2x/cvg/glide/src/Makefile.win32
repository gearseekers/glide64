# Win64 (x64) makefile for Glide2/CVG
# This makefile MUST be processed by GNU make!!!
#
# Converted from Win32 to x64 with SSE2 optimization.
#

#
#	Available options:
#
#	Environment variables:
#	DEBUG=1		disable optimizations and build for debug.
#			default = no
#	USE_X86=1	<- DISABLED for x64: Assembler triangle specializations are x86 specific.
#	USE_3DNOW=1	<- DISABLED for x64: 3DNow! is x86 specific.
#	USE_MMX=1	<- DISABLED for x64: MMX is x86 specific.
#	FXOEM2X=1	build fxoem2x.dll
#			default = no
#
#	Targets:
#	all:		build everything
#	glide2x:	build Glide2x lib
#	clean:		remove object files
#	realclean:	remove all generated files
#

.PHONY: all glide2x clean realclean
.INTERMEDIATE: fxgasm.exe
.SUFFIXES: .c .obj .rc .res

###############################################################################
#	general defines (user settable?)
###############################################################################

GLIDE_RES = glide.res
GLIDE_DLL = glide2x.dll
GLIDE_IMP = glide2x.lib

FX_GLIDE_SW = ../../../swlibs
GLIDE_LIBDIR = ../../lib

###############################################################################
#	tools
###############################################################################

CC = cl
AS = nasm
LD = link
RC = rc

ifeq ($(wildcard $(addsuffix /rm.exe,$(subst ;, ,$(PATH)))),)
UNLINK = del $(subst /,\,$(1))
else
UNLINK = $(RM) $(1)
endif

###############################################################################
#	defines
###############################################################################

# platform - TARGETING X64
CDEFS = -D_WIN64 -D_M_X64 -DDIRECTX -DFX_DLL_ENABLE -D__3Dfx_PCI_CFG__

# general
CDEFS += -DGLIDE_HW_TRI_SETUP=1 -DGLIDE_PACKED_RGB=1 -DGLIDE_TRI_CULLING=1 -DGLIDE_DEFAULT_GAMMA=1.3f -DGLIDE_LIB=1

# special sli buffer clears
CDEFS += -DGLIDE_BLIT_CLEAR=1

# workaround for CVGs with broken tsus which cannot send commands to multiple
# tmus using chipfield. chipfield will always be set to 0xf
CDEFS += -DGLIDE_CHIP_BROADCAST=1

# subsystem
CDEFS += -DCVG

# debug
ifdef DEBUG
CDEFS += -DGDBG_INFO_ON -DGLIDE_DEBUG -DGLIDE_SANITY_ASSERT -DGLIDE_SANITY_SIZE
endif

override USE_FIFO = 1

# *** X86-specific assembly features are DISABLED for x64 compilation. ***
# We force C-only triangle setup to avoid using the x86 assembly files.
CDEFS += -DGLIDE_USE_C_TRISETUP=1
override USE_DRAWTRI_ASM = 0
override USE_X86 = 0

# fifo
ifeq ($(USE_FIFO),1)
CDEFS += -DUSE_PACKET_FIFO=1 -DGLIDE_PACKET3_TRI_SETUP=1
endif

# other
CDEFS += -DGLIDE_PLUG -DGLIDE_SPLASH

###############################################################################
#	flags
###############################################################################

# linker - Targeting x64
LDFLAGS = -nologo -dll -machine:X64 -nodefaultlib

# assembler - For x64, assuming assembly files are disabled/rewritten
ASFLAGS = -O6 -fwin64 -D_WIN64 --prefix _
ASFLAGS += $(CDEFS)

# compiler - Targeting x64
CFLAGS = -nologo -W3 -WX -D__MSC__=1

# Standard x64 libraries
LDLIBS = user32.lib kernel32.lib advapi32.lib

ifdef DEBUG
CFLAGS += -Od -MTd -Zi
LDFLAGS += -debugtype:both -debug
LDLIBS += libcmtd.lib
else
CFLAGS += -DNDEBUG -O2 -MT
# *** SSE/SSE2 ENHANCEMENT: -O2 implicitly enables SSE2 on x64.
#    -arch:SSE2 explicitly instructs the compiler to use SSE2 for code generation.
CFLAGS += -arch:SSE2
LDFLAGS += -opt:icf,ref
LDLIBS += libcmt.lib
endif

CFLAGS += -I. -I../../incsrc -I../../init
CFLAGS += -I$(FX_GLIDE_SW)/fxmisc -I$(FX_GLIDE_SW)/newpci/pcilib -I$(FX_GLIDE_SW)/fxmemmap
CFLAGS += $(CDEFS)

# CPU optimizations (MMX, 3DNow!) are REMOVED/IGNORED as they are x86 specific.

###############################################################################
#	objects
###############################################################################

GLIDE_OBJECTS = \
	fifo.obj \
	gsplash.obj \
	g3df.obj \
	gu.obj \
	guclip.obj \
	gpci.obj \
	gump.obj \
	diglide.obj \
	disst.obj \
	ditex.obj \
	gbanner.obj \
	gerror.obj \
	gmovie.obj \
	digutex.obj \
	ddgump.obj \
	gaa.obj \
	gdraw.obj \
	gglide.obj \
	glfb.obj \
	gsst.obj \
	gtex.obj \
	gtexdl.obj \
	gutex.obj \
	cpuid.obj \
	fpu.obj \
	xtexdl_def.obj

# x86 assembly objects are excluded (USE_DRAWTRI_ASM=0, USE_X86=0)

GLIDE_OBJECTS += \
	gxdraw.obj

GLIDE_OBJECTS += \
	$(FX_GLIDE_SW)/newpci/pcilib/fxpci.obj \
	$(FX_GLIDE_SW)/newpci/pcilib/fxw32.obj \
	$(FX_GLIDE_SW)/newpci/pcilib/fxvxd.obj \
	$(FX_GLIDE_SW)/newpci/pcilib/fxnt.obj \
	$(FX_GLIDE_SW)/newpci/pcilib/fxmsr.obj \
	../../init/canopus.obj \
	../../init/dac.obj \
	../../init/gamma.obj \
	../../init/gdebug.obj \
	../../init/info.obj \
	../../init/parse.obj \
	../../init/print.obj \
	../../init/sli.obj \
	../../init/sst1init.obj \
	../../init/util.obj \
	../../init/video.obj \
	../../init/fxremap.obj

###############################################################################
#	rules
###############################################################################

.c.obj:
	$(CC) -Fo$@ $(CFLAGS) -c $<
.rc.res:
	$(RC) -Fo$@ $(CDEFS) -I$(FX_GLIDE_SW)/fxmisc $<

###############################################################################
#	main
###############################################################################
all: glide2x fxoem2x

glide2x: $(GLIDE_LIBDIR)/$(GLIDE_DLL)

$(GLIDE_LIBDIR)/$(GLIDE_DLL): $(GLIDE_OBJECTS) $(GLIDE_RES)
	$(LD) -out:$@ $(LDFLAGS) $(GLIDE_OBJECTS) $(LDLIBS) $(GLIDE_RES)

fxoem2x: $(GLIDE_LIBDIR)/fxoem2x.dll

ifeq ($(FXOEM2X),1)
$(GLIDE_LIBDIR)/fxoem2x.dll: ../oem/oeminit.obj ../oem/oeminit.res
#	$(LD) -out:$@ $(LDFLAGS) ../oem/oeminit.obj $(LDLIBS) ../oem/oeminit.res
else
$(GLIDE_LIBDIR)/fxoem2x.dll:
#	$(warning FxOem2x not enabled... Skipping fxoem2x.dll)
endif

###############################################################################
#	rules(2) - Exclude x86-Specific Assembly Rules
###############################################################################

# xdraw2_def.obj: xdraw2.asm (DISABLED - requires x64 rewrite)
#	$(AS) -o $@ $(ASFLAGS) $<
xtexdl_def.obj: xtexdl.c
	$(CC) -Fo$@ $(CFLAGS) -c $<
# xtexdl_mmx.obj: xtexdl.asm (DISABLED - x86 MMX)
# xdraw2_3dnow.obj: xdraw2.asm (DISABLED - x86 3DNow!)
# xtexdl_3dnow.obj: xtexdl.asm (DISABLED - x86 3DNow!)
# xdrawtri.obj: xdrawtri.asm (DISABLED - requires x64 rewrite)

$(GLIDE_OBJECTS): fxinline.h fxgasm.h

fxinline.h: fxgasm.exe
	$< -inline > $@

fxgasm.h: fxgasm.exe
	$< -hex > $@

fxgasm.exe: fxgasm.c
	$(CC) -o $@ $(CFLAGS) $<

###############################################################################
#	clean, realclean
###############################################################################

clean:
	-$(call UNLINK,*.obj)
	-$(call UNLINK,../../init/*.obj)
	-$(call UNLINK,$(FX_GLIDE_SW)/newpci/pcilib/*.obj)
	-$(call UNLINK,fxinline.h)
	-$(call UNLINK,fxgasm.h)
	-$(call UNLINK,../oem/oeminit.obj)
	-$(call UNLINK,../oem/oeminit.res)

realclean: clean
	-$(call UNLINK,$(GLIDE_LIBDIR)/glide2x.exp)
	-$(call UNLINK,$(GLIDE_LIBDIR)/$(GLIDE_DLL))
	-$(call UNLINK,$(GLIDE_LIBDIR)/$(GLIDE_IMP))
	-$(call UNLINK,$(GLIDE_LIBDIR)/fxoem2x.exp)
	-$(call UNLINK,$(GLIDE_LIBDIR)/fxoem2x.dll)
	-$(call UNLINK,$(GLIDE_LIBDIR)/fxoem2x.lib)