#
# Makefile for building glide2x library for linux
#

# ---
# User definable variables
# ---
CPU = x86-64
# DEBUG = 0
# GRX = svga

# ---
# Compiler and flags
# ---
CC = gcc
AS = as
LD = ld
AR = ar

# ---
# Architecture specific flags
# ---
ifeq ($(CPU), x86-64)
  CFLAGS_CPU = -m64 -msse2 -O2 -fPIC
  ASFLAGS_CPU = -m64
  LDFLAGS_CPU = -m64
else
  # ... (other CPU architectures) ...
endif

# ---
# Debugging flags
# ---
ifeq ($(DEBUG), 0)
  CFLAGS_DEBUG = -DNDEBUG
else
  CFLAGS_DEBUG = -g -DDEBUG
endif

# ---
# GRX specific flags
# ---
ifeq ($(GRX), svga)
  # ... (svga flags) ...
else
  CFLAGS_GRX = -I/usr/X11R6/include
  LDFLAGS_GRX = -L/usr/X11R6/lib -lX11 -lXxf86vm
endif

# ---
# General flags
# ---
CFLAGS = $(CFLAGS_CPU) $(CFLAGS_DEBUG) $(CFLAGS_GRX) -I../../../incsrc -I../../../../swlibs/fxmisc -I../../../../swlibs/newpci/pcilib -Wall
ASFLAGS = $(ASFLAGS_CPU)
LDFLAGS = $(LDFLAGS_CPU) $(LDFLAGS_GRX)

# ---
# Source files
# ---
C_SRCS = \
	$(wildcard *.c) \
	$(wildcard ../../init/*.c) \
	$(wildcard ../../../../swlibs/fxmisc/*.c) \
	$(wildcard ../../../../swlibs/newpci/pcilib/*.c)

ASM_SRCS = \
	$(wildcard *.S)

OBJS = \
	$(patsubst %.c, %.o, $(C